# ─────────────────────────────────────────────────────────────────────────────
# Edgeway — environment
# Copy to .env and fill in. Everything is optional: with no values the app runs
# in demo mode (local data, simulated realtime, browser notifications).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push — public key only. Generate both with:
#   npx web-push generate-vapid-keys
# The PRIVATE key goes into the Edge Function secret (see supabase/README.md),
# never into this file or the repo.
VITE_VAPID_PUBLIC_KEY=

# Optional: POST the quote form to an external endpoint (Formspree, own API)
# instead of the database. Leave empty to store leads in Supabase.
VITE_QUOTE_ENDPOINT=
