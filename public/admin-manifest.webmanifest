{
  "name": "Edgeway Admin",
  "short_name": "EW Admin",
  "description": "Quote requests and site imagery for edgewaysecurity.com.",
  "id": "/admin/",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3efe6",
  "theme_color": "#000b33",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Inbox", "url": "/admin/inquiries" },
    { "name": "Images", "url": "/admin/images" }
  ]
}
